@article{bomprezzi_wedded_2024,
	title = {Wedded to {Prosperity}? {Informal} {Influence} and {Regional} {Favoritism}},
	shorttitle = {Wedded to {Prosperity}?},
	url = {https://ideas.repec.org//p/ces/ceswps/_10969.html},
	abstract = {We investigate the informal inﬂuence of political leaders’ spouses on the subnational allocation of foreign aid. Building new worldwide datasets on personal characteristics of political leaders and their spouses as well as on geocoded development aid projects (including new data on 19 Western donors), we examine whether those regions within recipient countries that include the birthplace of leaders’ spouses attract more aid during their partners’ time in oﬃce. Our ﬁndings for the 1990–2020 period suggest that regions including the birthplaces of political leaders’ spouses receive substantially more aid from European donors, the United States, and China. We ﬁnd that more aid goes to spousal regions prior to elections and that developmental outcomes deteriorate rather than improve as a consequence. For Western aid but not for China, these results stand in some contrast to those for leader regions themselves. This suggests that aid from Western donors is directed from serving obvious political motives to promoting more hidden ones.},
	language = {en},
	urldate = {2024-12-12},
	journal = {CESifo Working Paper Series},
	author = {Bomprezzi, Pietro and Dreher, Axel and Fuchs, Andreas and Hailer, Teresa and Kammerlander, Andreas and Kaplan, Lennart and Marchesi, Silvia and Masi, Tania and Robert, Charlotte and Unfried, Kerstin},
	year = {2024},
	note = {Number: 10969
Publisher: CESifo},
	keywords = {birth regions, development, favouritism, informal influence, ODA, political economy},
	file = {Fullext PDF:C\:\\Users\\eman7\\Zotero\\storage\\5G6W3AUF\\Bomprezzi et al. - 2024 - Wedded to Prosperity Informal Influence and Regional Favoritism.pdf:application/pdf;Snapshot:C\:\\Users\\eman7\\Zotero\\storage\\IVZ3C5VH\\_10969.html:text/html},
}

@article{li_harmonized_2020,
	title = {A harmonized global nighttime light dataset 1992–2018},
	volume = {7},
	copyright = {2020 The Author(s)},
	issn = {2052-4463},
	url = {https://www.nature.com/articles/s41597-020-0510-y},
	doi = {10.1038/s41597-020-0510-y},
	abstract = {Nighttime light (NTL) data from the Defense Meteorological Satellite Program (DMSP)/Operational Linescan System (OLS) and the Visible Infrared Imaging Radiometer Suite (VIIRS) on the Suomi National Polar-orbiting Partnership satellite provide a great opportunity for monitoring human activities from regional to global scales. Despite the valuable records of nightscape from DMSP (1992–2013) and VIIRS (2012–2018), the potential of the historical archive of NTL observations has not been fully explored because of the severe inconsistency between DMSP and VIIRS. In this study, we generated an integrated and consistent NTL dataset at the global scale by harmonizing the inter-calibrated NTL observations from the DMSP data and the simulated DMSP-like NTL observations from the VIIRS data. The generated global DMSP NTL time-series data (1992–2018) show consistent temporal trends. This temporally extended DMSP NTL dataset provides valuable support for various studies related to human activities such as electricity consumption and urban extent dynamics.},
	language = {en},
	number = {1},
	urldate = {2024-12-12},
	journal = {Scientific Data},
	author = {Li, Xuecao and Zhou, Yuyu and Zhao, Min and Zhao, Xia},
	month = jun,
	year = {2020},
	note = {Publisher: Nature Publishing Group},
	keywords = {Environmental impact, Sustainability},
	pages = {168},
	file = {Full Text PDF:C\:\\Users\\eman7\\Zotero\\storage\\FD9QR2B4\\Li et al. - 2020 - A harmonized global nighttime light dataset 1992–2018.pdf:application/pdf},
}

@article{faguet_decentralization_2014,
